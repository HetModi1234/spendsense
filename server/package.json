{
  "name": "spendsense-server",
  "version": "1.0.0",
  "description": "SpendSense AI - Smart Personal Finance & Expense Intelligence Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
